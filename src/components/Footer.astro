---
import { site, nav } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink text-onink noise">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-display text-xl font-semibold tracking-tight">
        {site.name}
      </p>
      <p class="mt-3 max-w-sm text-sm text-onink">{site.description}</p>
      <a
        href="/contact"
        class="mt-6 btn-primary px-5 py-2.5"
      >
        Get Started <span aria-hidden="true">→</span>
      </a>
    </div>

    <div>
      <p class="label text-base! text-onink-muted">Site</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-onink hover:text-brand-bright">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="label text-base! text-onink-muted">Contact</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={`mailto:${site.email}`} class="text-onink hover:text-brand-bright">{site.email}</a></li>
        <li><a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`} class="text-onink hover:text-brand-bright">{site.phone}</a></li>
        {site.socials.map((s) => (
          <li><a href={s.href} class="text-onink hover:text-brand-bright">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-6 text-xs text-onink flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <p>{site.location}</p>
    </div>
  </div>
</footer>
