---
import { site } from "../site.config";
interface Props {
  heading?: string;
}
const { heading = "Ready? Get started now" } = Astro.props;
---

<section class="bg-surface px-6 py-20 sm:py-24">
  <div
    data-reveal
    class="relative mx-auto max-w-6xl overflow-hidden rounded-[var(--radius-card)] bg-linear-to-br from-brand to-brand-dark px-8 py-16 text-center text-white shadow-xl ring-1 ring-white/10 sm:px-14 sm:py-20"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 34px 34px;"
      aria-hidden="true"
    >
    </div>
    <div class="orb orb-a pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
    <div class="orb orb-b pointer-events-none absolute -bottom-28 -left-20 h-80 w-80 rounded-full bg-black/20 blur-3xl" aria-hidden="true"></div>

    <h2 class="relative text-3xl sm:text-5xl text-white">{heading}</h2>
    <p class="relative mx-auto mt-4 max-w-lg text-white/75">
      Getting started is simple. Fill out the form below, or reach out by
      email with any questions you may have.
    </p>

    <div class="relative mt-9 flex flex-wrap justify-center gap-3">
      <a
        href="/contact"
        class="pulse relative inline-flex items-center gap-1.5 rounded-full bg-white px-6 py-3 font-display font-semibold text-brand shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
      >
        Form <span aria-hidden="true">→</span>
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-1.5 rounded-full border border-white/40 px-6 py-3 font-display font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/10"
      >
        {site.email}
      </a>
    </div>
  </div>
</section>

<style>
  .orb {
    animation: drift 11s ease-in-out infinite alternate;
  }
  .orb-b {
    animation-name: drift-reverse;
    animation-duration: 13s;
  }

  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55);
    animation: pulse-ring 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
  }

  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(18px, 14px) scale(1.08);
    }
  }
  @keyframes drift-reverse {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-16px, -12px) scale(1.1);
    }
  }
  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.5);
    }
    75%,
    100% {
      box-shadow: 0 0 0 16px rgba(255, 255, 255, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb,
    .pulse::after {
      animation: none;
    }
  }
</style>
