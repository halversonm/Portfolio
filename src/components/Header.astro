---
import { site, nav } from "../site.config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-ink/85 text-onink backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src="/halverson-web-logo-reversed.svg"
        alt={site.name}
        class="h-8 w-auto"
        width="224"
        height="48"
      />
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "relative py-1.5 font-medium transition-colors",
              isActive(item.href)
                ? "text-onink after:absolute after:-bottom-[1px] after:left-0 after:h-[2px] after:w-full after:rounded-full after:bg-brand-bright after:content-['']"
                : "text-onink-muted hover:text-onink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="btn-primary px-4 py-2"
      >
        Get Started <span aria-hidden="true">→</span>
      </a>
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer rounded-lg p-2 -mr-2 hover:bg-white/5" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </summary>
      <div class="absolute right-0 mt-3 w-56 rounded-2xl border border-white/10 bg-ink-soft p-2 shadow-xl">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block rounded-xl px-3.5 py-2.5 font-medium text-sm text-onink-muted hover:bg-white/5 hover:text-onink"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/contact"
          class="mt-1 block rounded-xl bg-brand px-3.5 py-2.5 text-center font-display font-semibold text-sm text-white"
        >
          Get Started →
        </a>
      </div>
    </details>
  </div>
</header>
