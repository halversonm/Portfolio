---
import { site, nav } from "../site.config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-ink text-onink md:bg-ink/85 md:backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src="/halverson-web-logo-reversed.svg"
        alt={site.name}
        class="h-8 w-auto"
        width="224"
        height="48"
      />
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "relative py-1.5 font-medium transition-colors",
              isActive(item.href)
                ? "text-onink after:absolute after:-bottom-[1px] after:left-0 after:h-[2px] after:w-full after:rounded-full after:bg-brand-bright after:content-['']"
                : "text-onink-muted hover:text-onink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="btn-primary px-4 py-2"
      >
        Get Started <span aria-hidden="true">→</span>
      </a>
    </nav>

    <button
      type="button"
      class="menu-btn md:hidden"
      data-menu-btn
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-bar menu-bar-top"></span>
      <span class="menu-bar menu-bar-mid"></span>
      <span class="menu-bar menu-bar-bot"></span>
    </button>
  </div>

  <div id="mobile-menu" class="menu-panel md:hidden" data-menu-panel>
    <nav aria-label="Mobile">
      <ul class="space-y-1">
        {
          nav.map((item, i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between rounded-2xl px-4 py-4 font-display text-2xl font-semibold transition-colors active:bg-white/10",
                  isActive(item.href)
                    ? "bg-white/5 text-onink"
                    : "text-onink-muted hover:bg-white/5 hover:text-onink",
                ]}
              >
                <span class="flex items-center gap-3">
                  <span
                    class:list={[
                      "h-2 w-2 rounded-full",
                      isActive(item.href) ? "bg-brand-bright" : "bg-transparent",
                    ]}
                    aria-hidden="true"
                  />
                  {item.label}
                </span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-item mt-5" style={`--i:${nav.length}`}>
      <a href="/contact" class="btn-primary w-full py-3.5 text-lg">
        Get Started <span aria-hidden="true">→</span>
      </a>
      <p class="mt-4 text-center text-sm text-onink-muted">
        or call <a class="font-display text-base font-semibold text-onink underline decoration-white/30 underline-offset-4" href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a>
      </p>
    </div>
  </div>
</header>

<!-- Dimmed backdrop behind the open mobile menu. It lives outside <header> because the
     header's backdrop-blur would otherwise trap a fixed-position child inside the header box. -->
<div class="menu-backdrop md:hidden" data-menu-backdrop aria-hidden="true"></div>

<noscript>
  <style>
    .menu-btn, .menu-backdrop { display: none !important; }
    .menu-panel { position: static !important; opacity: 1 !important; visibility: visible !important; transform: none !important; }
    .menu-item { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<style>
  /* ---------- Hamburger → X ---------- */
  .menu-btn {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .menu-btn:hover,
  .menu-btn:active {
    background: rgba(255, 255, 255, 0.07);
  }
  .menu-btn:focus-visible {
    outline: 2px solid var(--color-brand-bright);
    outline-offset: 2px;
  }
  .menu-bar {
    position: absolute;
    left: 50%;
    width: 1.375rem;
    height: 2px;
    margin-left: -0.6875rem;
    border-radius: 9999px;
    background: currentColor;
    transition:
      transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.2s ease,
      top 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .menu-bar-top {
    top: calc(50% - 7px);
  }
  .menu-bar-mid {
    top: 50%;
  }
  .menu-bar-bot {
    top: calc(50% + 7px);
  }
  header[data-open] .menu-bar-top {
    top: 50%;
    transform: rotate(45deg);
  }
  header[data-open] .menu-bar-mid {
    opacity: 0;
    transform: scaleX(0.3);
  }
  header[data-open] .menu-bar-bot {
    top: 50%;
    transform: rotate(-45deg);
  }

  /* Header goes solid while the menu is open so bar and panel read as one piece */
  header {
    transition: background-color 0.3s ease;
  }
  header[data-open] {
    background-color: var(--color-ink);
  }

  /* ---------- Slide-down panel ---------- */
  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.75rem 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0 0 1.5rem 1.5rem;
    background: var(--color-ink);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity 0.28s ease,
      transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0.35s;
  }
  header[data-open] .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* Links drift in one after another */
  .menu-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  header[data-open] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(60ms + var(--i) * 45ms);
  }
  header:not([data-open]) .menu-panel {
    transition-duration: 0.18s;
  }
  header:not([data-open]) .menu-item {
    transition-duration: 0.12s;
  }

  /* ---------- Backdrop ---------- */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(8, 10, 11, 0.7);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }
  .menu-backdrop[data-open] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-bar,
    .menu-panel,
    .menu-item,
    .menu-backdrop {
      transition: none;
    }
    .menu-panel,
    .menu-item {
      transform: none;
    }
  }
</style>
