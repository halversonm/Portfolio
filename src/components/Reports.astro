---
/**
 * Marketing section for the two reports:
 *   • Launch & SEO report — included with every package
 *   • Monthly progress report on how the site is doing on Google — Full Service only
 * The mock-ups use placeholder shapes only (no invented numbers) and are labelled "Example".
 * Keep the claims in sync with `packages` in src/data/services.ts.
 */
interface Props {
  /** Hide the "see pricing" link (e.g. when already on the Services page). */
  hideLink?: boolean;
}
const { hideLink = false } = Astro.props;

const launchChecks = [
  "Page titles & descriptions set",
  "Sitemap created",
  "Images described for search",
  "Mobile-friendly layout",
];
---

<section class="relative overflow-hidden bg-ink text-onink noise">
  <div class="reports-glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="label text-brand-bright" data-reveal>Results you can see</p>
      <h2 data-reveal class="mt-3 text-3xl text-onink sm:text-5xl">
        Know how your website is doing — without lifting a finger.
      </h2>
      <p data-reveal class="mt-5 max-w-2xl text-lg text-onink-muted">
        A website should be working for your business, and you deserve to see
        it. Every site I launch comes with a Launch & SEO report, and Full Service clients
        get an update every month on how their site is doing on Google —
        explained clearly, with no logins or dashboards to figure out.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <!-- Launch & SEO report -->
      <article
        data-reveal="scale"
        class="rp flex flex-col rounded-[var(--radius-card)] border border-white/10 bg-ink-soft p-6 sm:p-8"
      >
        <p class="inline-flex w-fit items-center gap-1.5 rounded-full bg-brand-bright/15 px-3 py-1 label text-brand-bright">
          Included with every package
        </p>
        <h3 class="mt-4 text-2xl text-onink sm:text-3xl">Launch &amp; SEO report</h3>
        <p class="mt-3 text-onink-muted">
          When your site goes live, you get a clear summary of what I set up so
          Google can find and understand it, and where your site stands on day
          one.
        </p>

        <div class="rp-mock mt-7 rounded-2xl bg-surface p-5 text-ink shadow-xl" aria-hidden="true">
          <div class="flex items-center justify-between">
            <p class="font-display text-sm font-semibold">Launch &amp; SEO report</p>
            <span class="rounded-full bg-paper px-2.5 py-0.5 font-display text-[0.65rem] font-semibold uppercase tracking-wider text-muted">Example</span>
          </div>
          <ul class="mt-4 space-y-3">
            {
              launchChecks.map((label, i) => (
                <li class="rp-row flex items-center gap-3" style={`--i:${i}`}>
                  <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand text-white">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                      <path class="rp-tick" d="M5 13l4 4L19 7" pathLength="1" />
                    </svg>
                  </span>
                  <span class="text-sm">{label}</span>
                  <span class="ml-auto h-2 w-16 rounded-full bg-paper"></span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- Monthly progress report -->
      <article
        data-reveal="scale"
        style="transition-delay:110ms"
        class="rp flex flex-col rounded-[var(--radius-card)] border border-brand-bright/30 bg-ink-soft p-6 ring-1 ring-brand-bright/20 sm:p-8"
      >
        <p class="inline-flex w-fit items-center gap-1.5 rounded-full bg-brand px-3 py-1 label text-white">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z" />
          </svg>
          Full Service
        </p>
        <h3 class="mt-4 text-2xl text-onink sm:text-3xl">Monthly progress reports</h3>
        <p class="mt-3 text-onink-muted">
          Every month, I send you an easy-to-read report on how your website is
          doing on Google, so you can see it working for your business without
          logging into anything.
        </p>

        <div class="rp-mock mt-7 rounded-2xl bg-surface p-5 text-ink shadow-xl" aria-hidden="true">
          <div class="flex items-center justify-between">
            <p class="font-display text-sm font-semibold">Your site on Google</p>
            <span class="rounded-full bg-paper px-2.5 py-0.5 font-display text-[0.65rem] font-semibold uppercase tracking-wider text-muted">Example</span>
          </div>
          <svg viewBox="0 0 320 120" class="mt-3 w-full" fill="none">
            <defs>
              <linearGradient id="rp-area" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#2d5a3d" stop-opacity="0.28" />
                <stop offset="1" stop-color="#2d5a3d" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g class="stroke-line" stroke-width="1">
              <line x1="0" y1="20" x2="320" y2="20" />
              <line x1="0" y1="55" x2="320" y2="55" />
              <line x1="0" y1="90" x2="320" y2="90" />
            </g>
            <path class="rp-area" d="M0 98 C40 92 60 84 90 80 C120 76 140 82 170 64 C200 46 225 52 255 34 C280 22 300 24 320 14 V120 H0 Z" fill="url(#rp-area)" />
            <path class="rp-line" d="M0 98 C40 92 60 84 90 80 C120 76 140 82 170 64 C200 46 225 52 255 34 C280 22 300 24 320 14" stroke="#2d5a3d" stroke-width="3" stroke-linecap="round" pathLength="1" />
          </svg>
          <div class="mt-3 flex gap-3">
            <span class="h-2 w-20 rounded-full bg-paper"></span>
            <span class="h-2 w-12 rounded-full bg-paper"></span>
            <span class="h-2 w-16 rounded-full bg-paper"></span>
          </div>
        </div>
      </article>
    </div>

    <p data-reveal class="mt-8 text-sm text-onink-muted">
      The Launch &amp; SEO report comes with every package. Monthly progress reports are part of Full Service.
      {
        !hideLink && (
          <>
            {" "}
            <a href="/services" class="font-display text-base font-semibold text-brand-bright hover:text-white">See what's included →</a>
          </>
        )
      }
    </p>
  </div>
</section>

<style>
  .reports-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(48rem 22rem at 90% 0%, rgba(92, 174, 122, 0.16), transparent 65%),
      radial-gradient(40rem 20rem at 0% 100%, rgba(45, 90, 61, 0.3), transparent 65%);
  }

  /* ---- Play once as each card scrolls into view ---- */
  .rp-row {
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(0.35s + var(--i) * 0.14s);
  }
  .rp-tick {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.4s ease;
    transition-delay: calc(0.5s + var(--i, 0) * 0.14s);
  }
  .rp:global(.is-visible) .rp-row {
    opacity: 1;
    transform: none;
  }
  .rp:global(.is-visible) .rp-tick {
    stroke-dashoffset: 0;
  }

  .rp-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s;
  }
  .rp-area {
    opacity: 0;
    transition: opacity 1s ease 1.2s;
  }
  .rp:global(.is-visible) .rp-line {
    stroke-dashoffset: 0;
  }
  .rp:global(.is-visible) .rp-area {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-row,
    .rp-tick,
    .rp-line,
    .rp-area {
      opacity: 1;
      transform: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
