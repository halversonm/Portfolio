---
/** Fills empty grid slots until there's real client work to show — no placeholder company info. */
---

<div class="flex aspect-[16/10] flex-col items-center justify-center gap-3 rounded-[var(--radius-card)] border-2 border-dashed border-line bg-paper text-center">
  <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-tint text-brand" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <p class="font-display text-lg font-semibold text-muted">Coming soon</p>
</div>
