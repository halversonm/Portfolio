---
import type { Project } from "../data/projects";
import BrowserFrame from "./BrowserFrame.astro";
import SampleBadge from "./SampleBadge.astro";
interface Props {
  project: Project;
  compact?: boolean;
  /** Scroll through the site's full-page image on hover (uses project.fullPage). */
  scrollPreview?: boolean;
  /** Style for dark section backgrounds. */
  dark?: boolean;
  /** Heading level for the project name, so pages don't skip levels. */
  headingLevel?: "h2" | "h3";
}
const { project, compact = false, scrollPreview = false, dark = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<a href={`/work/${project.slug}`} class="group block" data-preview-host={scrollPreview && project.fullPage ? "" : undefined}>
  <BrowserFrame
    domain={project.domain}
    accent={project.accent}
    src={project.screenshot}
    alt={`${project.client} website`}
    preview={scrollPreview ? project.fullPage : undefined}
    class="transition-all duration-300 group-hover:-translate-y-1.5 group-hover:shadow-[0_30px_60px_-24px_rgba(0,0,0,0.45)]"
  />
  <div class="mt-4">
    <div class="flex flex-wrap items-center gap-2">
      <p class:list={["label", dark ? "text-brand-bright" : "text-brand"]}>{project.trade}</p>
      {project.sample && <SampleBadge />}
    </div>
    {compact ? (
      <Heading class:list={["mt-1.5 text-lg font-display font-semibold transition-colors", dark ? "group-hover:text-brand-bright" : "group-hover:text-brand"]}>
        {project.client}
      </Heading>
    ) : (
      <>
        <Heading class="mt-1.5 text-xl font-display group-hover:text-brand transition-colors">
          {project.title}
        </Heading>
        <p class="mt-2 text-sm text-muted">{project.summary}</p>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
          <span>{project.client}</span>
          <span aria-hidden="true">·</span>
          <span>{project.year}</span>
          <span aria-hidden="true">·</span>
          <span>{project.services.join(", ")}</span>
        </div>
      </>
    )}
  </div>
</a>
