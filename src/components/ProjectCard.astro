---
import type { Project } from "../data/projects";
import BrowserFrame from "./BrowserFrame.astro";
interface Props { project: Project; }
const { project } = Astro.props;
---

<a href={`/work/${project.slug}`} class="group block">
  <BrowserFrame
    domain={project.domain}
    accent={project.accent}
    src={project.screenshot}
    alt={`${project.client} website`}
    class="transition-all duration-300 group-hover:-translate-y-1.5 group-hover:shadow-[0_30px_60px_-24px_rgba(0,0,0,0.45)]"
  />
  <div class="mt-4">
    <p class="label text-brand">{project.trade}</p>
    <h3 class="mt-1.5 text-xl font-display group-hover:text-brand transition-colors">
      {project.title}
    </h3>
    <p class="mt-2 text-sm text-muted">{project.summary}</p>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
      <span>{project.client}</span>
      <span aria-hidden="true">·</span>
      <span>{project.year}</span>
      <span aria-hidden="true">·</span>
      <span>{project.services.join(", ")}</span>
    </div>
  </div>
</a>
