---
/**
 * Wraps a client-site screenshot in browser chrome.
 * Pass `src` once you have a real screenshot in src/assets or public/.
 * Until then it renders a labelled placeholder.
 */
interface Props {
  src?: string;
  alt?: string;
  domain?: string;
  accent?: string;
  class?: string;
}
const { src, alt = "", domain = "example.com", accent = "#2d5a3d", class: cls = "" } = Astro.props;
---

<figure class={`overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface shadow-[0_20px_50px_-20px_rgba(0,0,0,0.35)] transition-shadow duration-300 ${cls}`}>
  <div class="flex items-center gap-2 border-b border-line bg-paper px-4 py-2.5">
    <span class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
    </span>
    <span class="ml-2 truncate rounded-full bg-surface px-2.5 py-1 text-[0.7rem] text-muted">
      {domain}
    </span>
  </div>

  {
    src ? (
      <img src={src} alt={alt} class="block w-full" loading="lazy" />
    ) : (
      <div
        class="grid aspect-[16/10] place-items-center"
        style={`background: linear-gradient(140deg, ${accent}1f, ${accent}08);`}
      >
        <span class="label text-muted">Screenshot</span>
      </div>
    )
  }
</figure>
