---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import BrowserFrame from "../../components/BrowserFrame.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import SampleBadge from "../../components/SampleBadge.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const hasNext = next && next.slug !== project.slug;
---

<Layout title={project.client} description={project.summary}>
  <PageHero label={project.trade} title={project.client} width="max-w-4xl" compact>
    <a
      slot="before"
      href="/work"
      class="mb-8 inline-flex items-center gap-1 font-display text-xl font-semibold text-onink-muted transition-colors hover:text-brand-bright"
    >
      ← All work
    </a>
    <Fragment slot="after">
      {project.sample && <div class="mb-5"><SampleBadge /></div>}
      <p class="label text-onink-muted">Their Priorities:</p>
      <ul class="mt-3 max-w-2xl space-y-2">
        {
          project.highlights.map((h) => (
            <li class="flex items-start gap-2.5 text-lg text-onink-muted">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="mt-1.5 shrink-0 text-brand-bright"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{h}</span>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </PageHero>

  <div
    class="relative z-10 mx-auto -mt-8 max-w-4xl px-6 sm:-mt-10"
    data-reveal="scale"
    data-preview-host={project.fullPage ? "" : undefined}
  >
    <BrowserFrame
      domain={project.domain}
      accent={project.accent}
      src={project.screenshot}
      alt={`${project.client} website`}
      preview={project.fullPage}
      loading="eager"
      sizes="(min-width: 896px) 832px, 100vw"
    />
  </div>

  <article class="mx-auto max-w-2xl px-6 py-16">
    {project.liveUrl ? (
      <div data-reveal class="spotlight rounded-[var(--radius-card)] border border-line bg-surface p-8 text-center shadow-sm">
        <p class="text-lg leading-relaxed text-ink/90">
          This site is live! Please feel free to check it out.
        </p>
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-brand px-6 py-3 font-display font-semibold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-lg"
        >
          Navigate to company site <span aria-hidden="true">→</span>
        </a>
      </div>
    ) : (
      <dl data-reveal class="grid grid-cols-2 gap-6 rounded-[var(--radius-card)] border border-line bg-surface p-8 shadow-sm">
        {project.results.map((r) => (
          <div>
            <dt class="text-sm text-muted">{r.label}</dt>
            <dd class="mt-1 font-display text-3xl font-semibold text-brand">{r.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </article>

  {
    hasNext && (
      <section class="border-t border-line bg-surface">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
          <p class="label text-brand" data-reveal>Next project</p>
          <div data-reveal="scale" class="mt-8 max-w-lg">
            <ProjectCard project={next} compact scrollPreview headingLevel="h2" />
          </div>
        </div>
      </section>
    )
  }

  <CtaBand heading="Ready to start your own website?" />
</Layout>
