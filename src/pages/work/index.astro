---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { projects } from "../../data/projects";
---

<Layout title="Work" description="Recent websites built for local and blue-collar businesses.">
  <section class="bg-ink text-onink">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="label text-brand-bright">Work</p>
      <h1 class="mt-5 text-5xl sm:text-6xl text-onink">Sites that book work</h1>
      <p class="mt-5 max-w-xl text-lg text-onink-muted">
        Every project starts with the same question: what does this site need to
        do for the business? Usually it's phone calls, quote requests, or job
        applications. Then we build for that.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
      {projects.map((project, i) => (
        <div data-reveal style={`transition-delay:${(i % 2) * 100}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
