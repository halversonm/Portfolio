---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ComingSoonCard from "../../components/ComingSoonCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { projects, comingSoonSlots } from "../../data/projects";
---

<Layout title="Work" description="Recent websites built for small businesses.">
  <PageHero label="Work" title="Websites I've built">
    Real client work along with sample builds to show what's possible.
    <span class="hidden [@media(hover:hover)_and_(pointer:fine)]:inline">
      Hover over any site to scroll through the whole page.
    </span>
  </PageHero>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2">
      {projects.map((project, i) => (
        <div data-reveal="scale" style={`transition-delay:${(i % 2) * 100}ms`}>
          <ProjectCard project={project} compact scrollPreview headingLevel="h2" />
        </div>
      ))}
      {Array.from({ length: comingSoonSlots }).map((_, i) => (
        <div data-reveal="scale" style={`transition-delay:${((projects.length + i) % 2) * 100}ms`}>
          <ComingSoonCard />
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
