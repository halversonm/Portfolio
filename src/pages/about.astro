---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import StepTimeline from "../components/StepTimeline.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../site.config";

const process = [
  {
    name: "Consult & Design",
    text: "I learn about your business and we figure out your website needs and decide how you want the site to look.",
  },
  {
    name: "Build & Refine",
    text: "I'll build a draft of your site and share it with you. From there, we'll refine it together — up to 2 rounds of revisions are included, with more available if needed — until it's ready to go live.",
  },
  {
    name: "Launch",
    text: "Your site is published and made live — ready to bring in calls and new customers. Final quality checks are conducted.",
  },
];
---

<Layout title="About" description={`About ${site.name}.`}>
  <PageHero label="About" title="Welcome to Halverson Web" width="max-w-4xl">
    I'm glad you're here — let me tell you about myself.
  </PageHero>

  <!-- Story -->
  <section class="mx-auto max-w-3xl px-6 pt-16 sm:pt-24">
    <div class="space-y-6 text-lg leading-relaxed text-ink/85">
      <p data-reveal class="text-2xl leading-snug text-ink sm:text-3xl font-display font-semibold">
        I'm Max — a web developer based in the Twin Cities, building fast,
        content-driven websites for small businesses.
      </p>
      <p data-reveal>
        I have a background in software QA, so I bring a sharp eye for detail
        and reliability to every site I build. My goal for every client is to
        create a site that loads fast, looks great, works correctly on every
        device, and doesn't get in the way of customers trying to reach them.
      </p>
      <blockquote
        data-reveal="left"
        class="rounded-[var(--radius-card)] border-l-4 border-brand bg-brand-tint/60 px-6 py-5 text-xl font-display font-semibold leading-snug text-ink"
      >
        Building a website made easy.
      </blockquote>
      <p data-reveal>
        Most of the people I work with aren't tech experts — and they shouldn't
        have to be. I handle the technical side for you, explain things clearly, 
        and keep it simple, so you can spend your time on the work
        you're good at while I take care of your website. And when you need a
        change, every request is answered within 24 hours.
      </p>
      <p data-reveal>
        When I'm not building websites, you'll most likely find me fishing,
        watching sports, or on the golf course. Thank you so much for
        considering me as your web developer, I look forward to speaking with
        you!
      </p>
    </div>
  </section>

  <!-- How projects run -->
  <section class="overflow-x-clip">
    <div class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
      <p class="label text-brand" data-reveal>How projects run</p>
      <h2 data-reveal class="mt-3 text-3xl sm:text-4xl">3 steps is all it takes</h2>
      <div class="mt-10">
        <StepTimeline steps={process} />
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
