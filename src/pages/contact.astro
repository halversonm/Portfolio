---
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";


const field =
  "mt-1.5 w-full rounded-xl border border-line bg-surface px-3.5 py-2.5 outline-none transition-shadow focus:border-brand focus:ring-2 focus:ring-brand/20";
const fieldLabel = "font-display font-semibold text-sm";
---

<Layout title="Contact" description="Start a project or ask a question.">
  <section class="bg-ink text-onink">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="label text-brand-bright">Contact</p>
      <h1 class="mt-5 text-5xl sm:text-6xl text-onink">Let's talk about your site</h1>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-20 grid gap-14 md:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="text-lg text-muted">
        I'm excited to learn more about your business. I reply to every real inquiry within 2 business days.
      </p>

      <dl class="mt-10 space-y-5 text-sm">
        <div>
          <dt class="label text-brand">Email</dt>
          <dd class="mt-1"><a class="hover:text-brand" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        {/* <div>
          <dt class="label text-brand">Phone</dt>
          <dd class="mt-1"><a class="hover:text-brand" href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a></dd>
        </div> */}
        {/*<div>
          <dt class="label text-brand">Based in</dt>
          <dd class="mt-1">{site.location}</dd>
        </div>*/}
      </dl>
    </div>

    <form
      method="POST"
      name="Contact Form"
      data-netlify="true"
      action="/thank-you"
      data-reveal
      class="rounded-[var(--radius-card)] border border-line bg-paper p-6 shadow-sm sm:p-8 space-y-5"
    >
      <input type="hidden" name="form-name" value="Contact Form" />
      <div>
        <label for="name" class={fieldLabel}>Name</label>
        <input id="name" name="name" type="text" required class={field} />
      </div>
      <div>
        <label for="email" class={fieldLabel}>Email</label>
        <input id="email" name="email" type="email" required class={field} />
      </div>
      <div>
        <label for="phone" class={fieldLabel}>Phone</label>
        <input id="phone" name="phone" type="tel" class={field} />
      </div>
      <fieldset>
        <legend class={fieldLabel}>Preferred contact method</legend>
        <div class="mt-1.5 flex flex-wrap gap-2.5">
          {["Email", "Phone", "Doesn't matter"].map((option) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="preferredContact"
                value={option}
                checked={option === "Doesn't matter"}
                class="peer sr-only"
              />
              <span class="inline-flex items-center rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand/40 peer-focus-visible:ring-offset-2">
                {option}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <div>
        <label for="business" class={fieldLabel}>Business &amp; trade</label>
        <input id="business" name="business" type="text" placeholder="e.g. Carlson Heating & Air — HVAC" class={field} />
      </div>
      <div>
        <label for="message" class={fieldLabel}>Tell me a bit about your business and what you're looking for in a website</label>
        <textarea id="message" name="message" rows="5" required class={field}></textarea>
      </div>
      <button
        type="submit"
        class="w-full inline-flex items-center justify-center gap-1.5 rounded-full bg-brand px-6 py-3 font-display font-semibold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-md"
      >
        Send inquiry <span aria-hidden="true">→</span>
      </button>
      <p class="text-xs text-muted">
        Prefer email? Write to <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </form>
  </section>
</Layout>
