---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site.config";


const field =
  "mt-1.5 w-full rounded-xl border border-line bg-paper px-3.5 py-2.5 outline-none transition-shadow focus:border-brand focus:ring-2 focus:ring-brand/20";
const fieldLabel = "font-display font-semibold text-sm";
---

<Layout title="Contact" description="Start a project or ask a question.">
  <PageHero label="Contact" title="Let's talk about your site" width="max-w-5xl" compact />

  <section class="mx-auto grid max-w-5xl gap-14 px-6 py-16 sm:py-24 md:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="text-lg text-muted">
        I'm excited to learn more about your business. Tell me a little about what you do, and what you're looking for in a website. I reply to every real inquiry within 2 business days.
      </p>

      <ul class="mt-10 space-y-3">
        <li data-reveal>
          <!--email_off-->
          <a
            class="spotlight group flex items-center gap-4 rounded-[var(--radius-chip)] border border-line bg-surface p-4 transition-[translate,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-brand/30 hover:shadow-md"
            href={`mailto:${site.email}`}
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand-tint text-brand" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            </span>
            <span>
              <span class="label block text-brand">Email</span>
              <span class="mt-0.5 block font-medium">{site.email}</span>
            </span>
          </a>
          <!--/email_off-->
        </li>
        <li data-reveal style="transition-delay:90ms">
          <a
            class="spotlight group flex items-center gap-4 rounded-[var(--radius-chip)] border border-line bg-surface p-4 transition-[translate,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-brand/30 hover:shadow-md"
            href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand-tint text-brand" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
            </span>
            <span>
              <span class="label block text-brand">Phone</span>
              <span class="mt-0.5 block font-medium">{site.phone}</span>
            </span>
          </a>
        </li>
      </ul>

      <div data-reveal class="mt-12">
        <p class="label text-brand">What happens next</p>
        <ol class="mt-5 space-y-5">
          {
            [
              ["You send your details", "Fill out the form — a few sentences is plenty."],
              ["I reply within 2 business days", "A real response from me regarding your inquiry."],
              ["We plan your site together", "A short questionnaire and an optional call, then I get building."],
            ].map(([title, text], i) => (
              <li class="flex gap-4">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-ink font-display text-sm font-semibold text-onink">
                  {i + 1}
                </span>
                <div>
                  <p class="font-display text-lg font-semibold leading-tight">{title}</p>
                  <p class="mt-0.5 text-sm text-muted">{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <form
      method="POST"
      name="Contact Form"
      data-netlify="true"
      data-astro-reload
      action="/thank-you"
      data-reveal
      class="rounded-[var(--radius-card)] border border-line bg-surface p-6 shadow-xl ring-1 ring-brand/5 sm:p-8 space-y-5"
    >
      <input type="hidden" name="form-name" value="Contact Form" />
      <div>
        <label for="name" class={fieldLabel}>Name</label>
        <input id="name" name="name" type="text" required class={field} />
      </div>
      <div>
        <label for="email" class={fieldLabel}>Email</label>
        <input id="email" name="email" type="email" required class={field} />
      </div>
      <div>
        <label for="phone" class={fieldLabel}>Phone</label>
        <input id="phone" name="phone" type="tel" class={field} />
      </div>
      <fieldset>
        <legend class={fieldLabel}>Preferred contact method</legend>
        <div class="mt-1.5 flex flex-wrap gap-2.5">
          {["Email", "Phone", "Doesn't matter"].map((option) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="preferredContact"
                value={option}
                checked={option === "Doesn't matter"}
                class="peer sr-only"
              />
              <span class="inline-flex items-center rounded-full border border-line bg-paper px-4 py-2 text-sm font-medium transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand/40 peer-focus-visible:ring-offset-2">
                {option}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <div>
        <label for="business" class={fieldLabel}>Business &amp; trade</label>
        <input id="business" name="business" type="text" placeholder="e.g. Carlson Heating & Air — HVAC" class={field} />
      </div>
      <div>
        <label for="message" class={fieldLabel}>Tell me a bit about your business and what you're looking for in a website</label>
        <textarea id="message" name="message" rows="5" required class={field}></textarea>
      </div>
      <button
        type="submit"
        class="btn-primary w-full px-6 py-3"
      >
        Send inquiry <span aria-hidden="true">→</span>
      </button>
      <p class="text-xs text-muted">
        Prefer email? Write to <!--email_off--><a class="underline" href={`mailto:${site.email}`}>{site.email}</a><!--/email_off-->.
      </p>
    </form>
  </section>
</Layout>
