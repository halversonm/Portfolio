---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import StepTimeline from "../components/StepTimeline.astro";
import CtaBand from "../components/CtaBand.astro";
import CheckBadge from "../components/CheckBadge.astro";
import Reports from "../components/Reports.astro";
import { services, packages, packageScope } from "../data/services";

const steps = services.map((s) => ({ name: s.name, text: s.blurb, includes: s.includes }));
---

<Layout
  title="Services"
  description="Website design, local SEO, and ongoing care for local businesses."
>
  <PageHero label="Services" title="Every site built in 3 easy steps">
    I want your site up and running as efficiently as possible, with no
    confusion. You don't need to be tech-savvy — I handle the technical side so
    you can focus on running your business. Here's exactly how it works, plus
    pricing for every size of project.
  </PageHero>

  <!-- Process timeline -->
  <section class="overflow-x-clip">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <p class="label text-brand" data-reveal>How it works</p>
      <h2 data-reveal class="mt-3 max-w-2xl text-3xl sm:text-5xl">
        From first hello to live site
      </h2>
      <div class="mt-12">
        <StepTimeline steps={steps} />
      </div>
    </div>
  </section>

  <Reports hideLink />

  <!-- Packages -->
  <section class="relative overflow-hidden border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="label text-brand" data-reveal>Pricing</p>
      <h2 data-reveal class="mt-3 text-3xl sm:text-5xl">Choose your package</h2>
      <p data-reveal class="mt-4 max-w-lg text-muted">
        Pick the package that fits your business — no hidden fees or surprises.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-3 md:items-stretch">
        {
          packages.map((pkg, i) => (
            <div
              data-reveal="scale"
              style={`transition-delay:${i * 100}ms`}
              class:list={[
                "relative flex flex-col overflow-hidden rounded-[var(--radius-card)] p-8 transition-[translate,box-shadow] duration-300 hover:-translate-y-1.5",
                pkg.featured
                  ? "bg-ink text-onink shadow-2xl ring-1 ring-brand-bright/40 md:-my-3 md:py-11"
                  : "spotlight border border-line bg-paper shadow-sm hover:shadow-lg",
              ]}
            >
              {pkg.featured && (
                <>
                  <div class="pkg-glow" aria-hidden="true" />
                  <p class="label relative inline-flex w-fit items-center gap-1.5 rounded-full bg-brand px-3 py-1 text-white">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z" />
                    </svg>
                    Most common
                  </p>
                </>
              )}
              <h3 class:list={["relative text-xl font-display", pkg.featured ? "mt-4" : "mt-2"]}>{pkg.name}</h3>
              <p
                class:list={[
                  "relative mt-1 font-display text-3xl font-semibold",
                  pkg.featured ? "text-brand-bright" : "text-brand",
                ]}
              >
                {pkg.price}
              </p>
              <p
                class:list={[
                  "relative mt-3 text-sm",
                  pkg.featured ? "text-onink-muted" : "text-muted",
                ]}
              >
                {pkg.fit}
              </p>
              <ul class="relative mt-6 flex-1 space-y-3 text-sm">
                {pkg.points.map((p) => (
                  <li class="flex gap-3">
                    <CheckBadge tone={pkg.featured ? "solid" : "tint"} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              {pkg.contactCta && (
                <a
                  href="/contact/"
                  class="relative mt-7 btn-primary w-fit px-5 py-2.5"
                >
                  Get in touch <span aria-hidden="true">→</span>
                </a>
              )}
              {pkg.featured && (
                <a
                  href="/contact/"
                  class="relative mt-7 btn-primary w-fit px-5 py-2.5 hover:bg-brand-bright!"
                >
                  Get started <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          ))
        }
      </div>

      <div
        data-reveal
        class="spotlight mt-14 rounded-[var(--radius-card)] border-2 border-brand/20 bg-paper p-8 shadow-md sm:p-10"
      >
        <p class="label text-brand">More Information</p>
        <h3 class="mt-2 text-2xl sm:text-3xl">Things to Note</h3>
        <div class="mt-6 grid gap-8 sm:grid-cols-2">
          <div>
            <p class="text-muted">{packageScope.note}</p>
            <ul class="mt-4 space-y-2.5 text-sm">
              {packageScope.includes.map((item) => (
                <li class="flex gap-3">
                  <CheckBadge />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-muted">
              Websites that include more complex features like the things below will need a{" "}
              <span class="font-semibold text-ink">custom quote</span> instead:
            </p>
            <ul class="mt-4 space-y-2.5 text-sm text-muted">
              {packageScope.excludes.map((item) => (
                <li class="flex gap-3">
                  <span class="text-brand" aria-hidden="true">→</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to get started?" />
</Layout>

<style>
  .pkg-glow {
    position: absolute;
    top: -5rem;
    right: -5rem;
    width: 18rem;
    height: 18rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(92, 174, 122, 0.3), transparent 65%);
    pointer-events: none;
  }
</style>
