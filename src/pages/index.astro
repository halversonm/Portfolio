---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ComingSoonCard from "../components/ComingSoonCard.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import CtaBand from "../components/CtaBand.astro";
import FoundationCard from "../components/FoundationCard.astro";
import HandsOff from "../components/HandsOff.astro";
import Reports from "../components/Reports.astro";
import StepTimeline from "../components/StepTimeline.astro";
import { site } from "../site.config";
import { projects } from "../data/projects";
import { services } from "../data/services";
import { foundation } from "../data/foundation";

const featured = projects.slice(0, 3);
const comingSoonCount = Math.max(0, 3 - featured.length);

// Only facts that are true of how I work — no made-up client numbers.
const stats = [
  { value: 3, suffix: "", label: "Simple steps from first call to launch" },
  { value: 2, suffix: "", label: "Rounds of revisions included" },
  { value: 100, suffix: "%", label: "Custom-built" },
  { value: 24, suffix: " hrs", label: "Longest you'll wait for a reply to any request" },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-onink noise" data-parallax>
    <div class="aurora" aria-hidden="true">
      <i></i><i></i><i></i>
    </div>
    <div class="grid-lines" aria-hidden="true"></div>

    <div
      class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-20 grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
    >
      <div>
        <p class="label text-brand-bright inline-flex items-center gap-2.5">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-bright opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-bright"></span>
          </span>
          Professional web development for small businesses
        </p>
        <h1 class="mt-6 text-5xl sm:text-6xl lg:text-[5.25rem] text-onink" aria-label={site.tagline}>
          <span id="hero-typewriter" data-text={site.tagline} aria-hidden="true">{site.tagline}</span><span class="hero-caret" aria-hidden="true"></span><span id="hero-typewriter-rest" class="invisible" aria-hidden="true"></span>
        </h1>
        <p class="mt-7 max-w-xl text-lg sm:text-xl text-onink-muted">
          {site.description}
        </p>
        <p class="mt-4 max-w-xl font-display text-xl font-semibold text-brand-bright sm:text-2xl">
          You focus on your business. I'll handle the website.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="hero-cta relative btn-primary px-7 py-3.5 text-lg"
          >
            Get Started <span aria-hidden="true">→</span>
          </a>
          <a
            href="/work"
            class="btn-ghost px-7 py-3.5 text-lg"
          >
            See the work
          </a>
        </div>
      </div>

      <div data-reveal="scale" class="hero-stage" data-tilt-area>
        <div class="deck" data-deck data-tilt="6">
          {
            featured.map((project, i) => (
              <div
                class="deck-slide"
                data-slide
                data-pos={i}
                data-caption={`${project.client} — ${project.trade}`}
                aria-hidden={i === 0 ? "false" : "true"}
              >
                <BrowserFrame
                  domain={project.domain}
                  accent={project.accent}
                  src={project.screenshot}
                  alt={i === 0 ? `${project.client} website` : ""}
                  loading={i === 0 ? "eager" : "lazy"}
                  sizes="(min-width: 1024px) 520px, 100vw"
                />
              </div>
            ))
          }
        </div>
        <p class="mt-5 text-center label text-onink-muted" data-deck-caption aria-live="polite">
          {featured[0].client} — {featured[0].trade}
        </p>
        {
          featured.length > 1 && (
            <div class="mt-2 flex justify-center">
              {featured.map((_, i) => (
                <button
                  type="button"
                  data-deck-dot
                  class:list={["hero-dot", i === 0 && "is-active"]}
                  aria-label={`Show project ${i + 1} of ${featured.length}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>

    <!-- Stats band -->
    <div class="relative border-t border-white/10 bg-black/20 backdrop-blur-sm">
      <dl class="mx-auto grid max-w-6xl gap-y-8 px-6 py-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-4 lg:gap-x-8">
        {
          stats.map((s, i) => (
            <div data-reveal style={`transition-delay:${i * 100}ms`} class="text-center sm:text-left lg:border-l lg:border-white/10 lg:pl-8 first:lg:border-l-0 first:lg:pl-0">
              <dt class="font-display text-5xl font-semibold tracking-tight text-onink sm:text-6xl">
                <span data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
              </dt>
              <dd class="mx-auto mt-2 max-w-[16rem] text-sm text-onink-muted sm:mx-0">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <HandsOff />

  <Reports />

  <!-- Foundation -->
  <section class="bg-surface border-y border-line">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="label text-brand" data-reveal>Core Values</p>
      <h2 data-reveal class="mt-3 max-w-2xl text-3xl sm:text-5xl">
        The foundation of every Halverson Web site
      </h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          foundation.map((item, i) => (
            <FoundationCard item={item} wide={i === 0} delay={(i % 3) * 90} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process: scroll-driven timeline -->
  <section class="overflow-x-clip">
   <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="label text-brand" data-reveal>Process</p>
        <h2 data-reveal class="mt-3 text-3xl sm:text-5xl">
          Building your site consists of 3 steps
        </h2>
        <p data-reveal class="mt-5 max-w-md text-muted">
          No surprises, no jargon — you always know what's happening and what comes next.
        </p>
        <a
          href="/services"
          data-reveal
          class="mt-8 inline-flex items-center gap-1.5 font-display font-semibold text-brand hover:text-brand-dark"
        >
          Services &amp; pricing <span aria-hidden="true">→</span>
        </a>
      </div>

      <StepTimeline compact steps={services.map((s) => ({ name: s.name, text: s.blurb }))} />
    </div>
   </div>
  </section>

  <!-- Selected work: dark showcase with hover scroll-through -->
  <section class="relative overflow-hidden bg-ink text-onink noise">
    <div class="showcase-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label text-brand-bright" data-reveal>Featured work</p>
          <h2 data-reveal class="mt-3 text-3xl sm:text-5xl text-onink">Recent builds</h2>
          <p data-reveal class="mt-4 max-w-md text-onink-muted">
            <span class="hidden [@media(hover:hover)_and_(pointer:fine)]:inline">Hover over a site to scroll through the whole page. </span>Click for the details.
          </p>
        </div>
        <a
          href="/work"
          class="font-display font-semibold text-base text-onink-muted hover:text-brand-bright whitespace-nowrap transition-colors"
        >
          All work →
        </a>
      </div>
      <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((project, i) => (
            <div data-reveal="scale" style={`transition-delay:${i * 110}ms`}>
              <ProjectCard project={project} scrollPreview dark />
            </div>
          ))
        }
        {
          Array.from({ length: comingSoonCount }).map((_, i) => (
            <div data-reveal="scale" style={`transition-delay:${(featured.length + i) * 110}ms`}>
              <ComingSoonCard />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .hero-caret {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    margin-left: 4px;
    vertical-align: -0.1em;
    background: currentColor;
    animation: hero-caret-blink 1s steps(2) infinite;
  }

  @keyframes hero-caret-blink {
    50% {
      opacity: 0;
    }
  }

  .hero-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid rgba(92, 174, 122, 0.6);
    animation: hero-cta-ring 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .hero-cta:hover::before {
    animation-play-state: paused;
  }

  @keyframes hero-cta-ring {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75%,
    100% {
      transform: scale(1.12, 1.4);
      opacity: 0;
    }
  }

  /* Stacked "deck" of project screenshots */
  .hero-stage {
    perspective: 1400px;
  }
  .deck {
    display: grid;
    padding-top: 3rem;
    padding-right: 1.5rem;
    touch-action: pan-y; /* horizontal swipes go to the carousel, vertical scrolls the page */
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    will-change: transform;
  }
  .deck-slide {
    grid-area: 1 / 1;
    transition:
      transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.8s ease,
      filter 0.8s ease;
    opacity: 0;
    pointer-events: none;
  }
  .deck-slide[data-pos="0"] {
    z-index: 3;
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
  }
  .deck-slide[data-pos="1"] {
    z-index: 2;
    opacity: 0.55;
    filter: brightness(0.7) saturate(0.9);
    transform: translate3d(4.5%, -9%, -60px) scale(0.93);
    pointer-events: auto;
    cursor: pointer;
  }
  .deck-slide[data-pos="2"] {
    z-index: 1;
    opacity: 0.28;
    filter: brightness(0.55) saturate(0.8);
    transform: translate3d(9%, -18%, -120px) scale(0.86);
    pointer-events: auto;
    cursor: pointer;
  }

  /* 24px tap target; the visible dot is drawn by ::before */
  .hero-dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .hero-dot::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.25);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.2s ease,
      width 0.3s ease;
  }
  .hero-dot:hover::before {
    background: rgba(255, 255, 255, 0.45);
  }
  .hero-dot.is-active::before {
    background: var(--color-brand-bright);
    width: 1.25rem;
  }

  .showcase-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60rem 28rem at 85% -10%, rgba(92, 174, 122, 0.18), transparent 65%),
      radial-gradient(48rem 24rem at 0% 110%, rgba(45, 90, 61, 0.35), transparent 65%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-caret,
    .hero-cta::before {
      animation: none;
    }
    .hero-caret {
      display: none;
    }
    .deck {
      transform: none;
    }
    .deck-slide {
      transition: none;
    }
  }
</style>
