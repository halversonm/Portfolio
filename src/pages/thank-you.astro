---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site.config";
---

<Layout title="Thank you" description="Your message has been sent.">
  <PageHero label="Message sent" title="Thanks — it's on its way" align="center" width="max-w-3xl">
    <span slot="before" class="thanks-check mx-auto mb-8 grid h-20 w-20 place-items-center rounded-full bg-brand text-white shadow-[0_0_0_10px_rgba(92,174,122,0.15)]" aria-hidden="true">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="thanks-tick" d="M5 13l4 4L19 7" pathLength="1" />
      </svg>
    </span>
    I've got your message and will reply within two business days. I look
    forward to connecting with you.
    <Fragment slot="after">
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="btn-primary px-6 py-3"
        >
          Back home <span aria-hidden="true">→</span>
        </a>
        <a
          href="/work"
          class="btn-ghost px-6 py-3"
        >
          See the work
        </a>
      </div>
      <p class="mt-8 text-sm text-onink-muted">
        Or write to <!--email_off--><a
          class="underline hover:text-brand-bright"
          href={`mailto:${site.email}`}>{site.email}</a
        ><!--/email_off-->
      </p>
    </Fragment>
  </PageHero>
</Layout>

<style>
  .thanks-tick {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: thanks-draw 0.7s ease 0.35s forwards;
  }
  @keyframes thanks-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .thanks-check {
    animation: thanks-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes thanks-pop {
    from {
      transform: scale(0.5);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks-tick {
      animation: none;
      stroke-dashoffset: 0;
    }
    .thanks-check {
      animation: none;
    }
  }
</style>
